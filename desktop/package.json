{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "description": "Groundwork: write only what your sources say. Organize your documents and write from them with verified citations.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "smoke": "vite build && cross-env RC_SMOKE_TEST=1 electron .",
    "typecheck": "tsc --noEmit",
    "bundle-backend": "cd ../backend && .venv\\Scripts\\python -m PyInstaller groundwork-backend.spec --noconfirm",
    "dist": "npm run build && npm run bundle-backend && electron-builder --win"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "cytoscape": "^3.33.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.groundwork.app",
    "productName": "Groundwork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.*",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/groundwork-backend",
        "to": "backend"
      },
      {
        "from": "../samples",
        "to": "samples"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Groundwork-Setup-${version}.${ext}"
    }
  }
}
